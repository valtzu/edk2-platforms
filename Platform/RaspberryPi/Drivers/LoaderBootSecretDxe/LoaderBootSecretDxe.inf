#/** @file
#  Serves systemd-boot's "LoaderBootSecret" EFI variable from a value the
#  VideoCore firmware derives from the RPi4/CM4 device private key in OTP,
#  instead of the regular NV variable store.
#
#  Copyright (c) 2026, Valtteri R
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
#**/

[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = LoaderBootSecretDxe
  FILE_GUID                      = d06830b1-1a15-4c88-9ea0-450ee7e88085
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = LoaderBootSecretDxeInitialize

[Sources]
  LoaderBootSecretDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Platform/RaspberryPi/RaspberryPi.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  FdtLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiRuntimeServicesTableLib

[Guids]
  gEfiEventExitBootServicesGuid
  gEfiGlobalVariableGuid
  gConfigDxeFormSetGuid

[Protocols]
  gRaspberryPiFirmwareProtocolGuid    ## CONSUMES
  gEfiVariableArchProtocolGuid        ## CONSUMES

[Depex]
  gRaspberryPiFirmwareProtocolGuid AND
  gEfiVariableArchProtocolGuid

[FixedPcd]
  gRaspberryPiTokenSpaceGuid.PcdFdtBaseAddress
